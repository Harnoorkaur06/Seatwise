# SEATWISE Environment Configuration Template (Placeholders Only)

# Server Configuration
PORT=3000
NODE_ENV=development

# Persistent MongoDB Connection URI
# Local MongoDB (recommended for local development):
MONGODB_URI=mongodb://localhost:27017/seatwise
# Remote/Atlas example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/seatwise?retryWrites=true&w=majority

# Optional: Explicit Opt-In Embedded In-Memory MongoDB Runner
# Set to true ONLY if you want to run zero-install evaluation without an active local MongoDB daemon.
# Default is false. Production will never use in-memory database.
USE_IN_MEMORY_DB=false

# Security & Session Authentication (Must be set to a strong secret in production)
JWT_SECRET=seatwise_dev_secret_key_please_change_in_production
JWT_EXPIRES_IN=7d

# University Administrator Initial Provisioning (Used on first-time database initialization only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=seatwise@admin123

# Mandatory 4-Digit Email OTP Verification (SMTP Service)
# Provide your SMTP server credentials (e.g. Gmail App Password, SendGrid, Amazon SES, Mailgun, or university relay)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-university-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=SEATWISE Platform <your-university-email@gmail.com>

# Automated 24-Hour Personalized Examination Reminder Scheduling
# Default timezone for scheduled examination times (e.g. Asia/Kolkata, UTC, America/New_York)
EXAM_TIMEZONE=Asia/Kolkata
# Scheduled check polling interval in milliseconds (default: 60000 = 1 minute)
REMINDER_CHECK_INTERVAL_MS=60000
# Maximum retry attempts for temporary email provider delivery failures
MAX_REMINDER_RETRIES=3
